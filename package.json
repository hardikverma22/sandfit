{
  "name": "sandfit",
  "version": "0.6.0",
  "description": "Turn on your coding agent's sandbox without breaking your workflow. sandfit reads your Claude Code and Codex history and writes a least-privilege sandbox policy that fits how you actually work.",
  "type": "module",
  "bin": {
    "sandfit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:sandbox": "SANDFIT_REAL_SANDBOX=1 vitest run test/sandbox",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "bench": "tsx bench/all.ts",
    "bench:accuracy": "tsx bench/accuracy.ts",
    "bench:perf": "tsx bench/perf.ts",
    "bench:sandbox": "tsx bench/sandbox.ts",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "claude-code",
    "codex",
    "sandbox",
    "ai-agents",
    "security",
    "least-privilege",
    "seatbelt",
    "bubblewrap",
    "nono",
    "permissions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardikverma22/sandfit.git"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.81",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/hardikverma22/sandfit#readme",
  "bugs": {
    "url": "https://github.com/hardikverma22/sandfit/issues"
  }
}
